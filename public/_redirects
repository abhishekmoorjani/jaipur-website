# Redirects from the old Squarespace URLs to their equivalents on this site.
#
# Every path below is a real, currently indexed URL taken from
# https://jaipur-freiburg.de/sitemap.xml. Without these they would 404 after
# the switch, and any search ranking or inbound link pointing at them would be
# thrown away rather than passed on.
#
# 301 = permanent, which is what tells search engines to move the ranking.
#
# Format is understood by Cloudflare Pages and Netlify. GitHub Pages ignores
# this file, so it only takes effect once the site moves to its own domain on
# one of those hosts.

# Squarespace used /welcome as the landing page, with a stray duplicate.
/welcome                    /                 301
/welcome2                   /                 301
/neue-seite                 /                 301

# Menu pages. The full menu opens from the homepage.
/speisekarte                /#speisekarte     301
/mittagsmen                 /#speisekarte     301

# Gallery and directions.
/food-gallery               /#gallery         301
/anfahrt-1                  /#contact         301

# Squarespace combined both legal notices on one page; this site splits them,
# so the old URL goes to the Impressum, which links on to the Datenschutz.
/impressum-und-datenschutz  /impressum        301

# Squarespace's own internal paths that sometimes get indexed.
/config                     /                 301
/home                       /                 301
